import re
import random
import time
from collections import Counter
 
calls = [
    "seeds not received seeds delayed",
    "fertiliser price high",
    "seeds price high subsidy not received",
]
STOP = {"not", "high"}
 
def frequencies(texts, stop):
    counts = {}
    for text in texts:
        words = re.findall(r"[a-z]+", text.lower())
        for word in words:
            if word not in stop:
                counts[word] = counts.get(word, 0) + 1
    return counts
 
def top(counts, k):
    return sorted(counts.items(), key=lambda item: (-item[1], item[0]))[:k]
 
def group_by_district(records):
    grouped = {}
    for district, complaint in records:
        grouped.setdefault(district, []).append(complaint)
    return grouped
 
print(top(frequencies(calls, STOP), 3))
records = [
    ("Thiruvallur", "seeds delayed"),
    ("Chennai", "water supply"),
    ("Thiruvallur", "fertiliser price")
]
print(group_by_district(records))
 
# Scale test: generated complaint sentences
random.seed(4)
vocabulary = ["seed", "crop", "water", "price", "loan", "pest", "soil", "yield"]
for n in (1000, 10000, 100000):
    texts = [" ".join(random.choices(vocabulary, k=8)) for _ in range(n)]
    start = time.perf_counter()
    result = frequencies(texts, set())
    dict_time = time.perf_counter() - start
    start = time.perf_counter()
    counter_result = Counter(word for text in texts for word in text.split())
    counter_time = time.perf_counter() - start
    print(n, "dictionary words:", sum(result.values()),
          "Counter words:", sum(counter_result.values()),
          "dictionary:", round(dict_time, 4),
          "Counter:", round(counter_time, 4))
