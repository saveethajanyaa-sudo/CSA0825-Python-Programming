BASE_RATE = 30
FAT_RATE = 0.40
SNF_RATE = 0.30
MIN_FAT = 2
MAX_FAT = 7

def calculate_payment(quantity, fat, snf):
    if quantity <= 0 or fat < MIN_FAT or fat > MAX_FAT or snf <= 0:
        raise ValueError("Invalid entry")

    return quantity * (BASE_RATE + FAT_RATE * fat + SNF_RATE * snf)

def main():
    total = 0

    for day in range(1, 11):
        try:
            quantity = float(input("Enter quantity: "))
            fat = float(input("Enter fat percentage: "))
            snf = float(input("Enter SNF percentage: "))

            payment = calculate_payment(quantity, fat, snf)
            print("Payment:", payment)
            total += payment

        except ValueError:
            print("Invalid entry. Payment not added.")

    print("Total payment:", total)

main()


def test_payment():
    payment = calculate_payment(10, 3, 7)
    expected = 333

    if payment == expected:
        print("Test Passed")
    else:
        print("Test Failed")

test_payment()

