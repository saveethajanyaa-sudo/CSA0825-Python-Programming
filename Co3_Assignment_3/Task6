def build_index(data):
    index = defaultdict(list)
    for number, info in data.items():
        for station, arrival, departure in info["stops"]:
            index[station].append(number)
    return index
 
def find_trains(data, station, day):
    matches = []
    for number, info in data.items():
        if day in info["days"]:
            for stop, arrival, departure in info["stops"]:
                if stop == station:
                    matches.append((departure, number, info["name"]))
    return sorted(matches, key=lambda item: item[0])
 
