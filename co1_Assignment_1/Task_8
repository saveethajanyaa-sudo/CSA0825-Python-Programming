BEGIN
    total ← 0

    FOR day ← 1 TO 10
        INPUT quantity, fat, SNF

        IF quantity > 0 AND
           fat >= 2 AND fat <= 7 AND SNF > 0 THEN

            payment ← quantity ×
                      (30 + 0.40 × fat + 0.30 × SNF)

            DISPLAY payment
            total ← total + payment

        ELSE
            DISPLAY "Invalid Entry"
        END IF
    END FOR

    DISPLAY total
END
